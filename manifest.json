{
  "manifest_version": 3,
  "name": "Indian Freelancer Tax Calculator",
  "version": "1.0.0",
  "description": "Tax calculator for Indian freelancers — income tax, advance tax deadlines, GST threshold, TDS tracker. Works offline. No account needed.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Indian Freelancer Tax Calculator"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
